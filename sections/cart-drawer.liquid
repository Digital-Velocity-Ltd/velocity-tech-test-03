<div id="cart-drawer" hidden>
  <div data-cart-overlay></div>
  <aside role="dialog" aria-modal="true" aria-labelledby="cart-drawer-title" tabindex="-1">
    <header>
      <h2 id="cart-drawer-title">Your basket</h2>
      <button data-cart-close>Close</button>
    </header>

    <div aria-live="polite">
      {% if cart.item_count == 0 %}
        <p>Your cart is empty.</p>
      {% else %}
        <ul>
          {% for item in cart.items %}
            <li data-key="{{ item.key }}">
              {% if item.image %}
                <img src="{{ item.image | image_url: width: 120 }}" alt="{{ item.image.alt | escape }}" loading="lazy" width="60" height="60">
              {% endif %}
              <div>
                <a href="{{ item.url }}">{{ item.product.title }}</a>
                {% unless item.variant.title == 'Default Title' %}
                  <div>{{ item.variant.title }}</div>
                {% endunless %}
                <div>
                  <button type="button" data-dec>−</button>
                  <input value="{{ item.quantity }}" inputmode="numeric" pattern="[0-9]*" aria-label="Quantity">
                  <button type="button" data-inc>＋</button>
                  <button type="button" data-remove>Remove</button>
                </div>
              </div>
              <strong>{{ item.final_line_price | money }}</strong>
            </li>
          {% endfor %}
        </ul>

        <div>
          <div>Subtotal: {{ cart.total_price | money }}</div>
          <a href="/checkout">Checkout</a>
        </div>
      {% endif %}
    </div>
  </aside>
</div>

<button data-cart-open>
  Cart (<span data-cart-count>{{ cart.item_count }}</span>)
</button>

{% schema %}{ "name": "Cart drawer" }{% endschema %}
