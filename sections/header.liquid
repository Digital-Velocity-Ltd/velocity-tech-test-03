{%- liquid

-%}

{% style %}
  #shopify-section-{{ section.id }} {
  }
{% endstyle %}

<div class="header__container container">
  <div class="header__grid">
    {% if section.settings.logo != blank %}
      <div class="header__logo">
        {{
          section.settings.logo
          | image_url: width: 100
          | image_tag: width: 100, height: 100, alt: section.settings.logo.alt
        }}
      </div>
    {% endif %}

    {% if section.settings.menu != blank %}
      <div class="header__menu">
        {% render 'menu', menu: section.settings.menu %}
      </div>
    {% endif %}
    <div class="header__icons">
      <button
        type="button"
        class="header__icon"
        data-open-cart-drawer
        aria-label="Open cart drawer"
      >
        <span class="header__icon-text"
          >Cart (<span data-cart-count>{{ cart.item_count }}</span>)</span
        >
      </button>
      {% if shop.customer_accounts_enabled %}
        <a href="{{ routes.account_url }}" class="header__icon">
          <span class="header__icon-text">Account</span>
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "class": "header",
  "tag": "header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "header",
      "content": "Styles"
    },
    {
      "type": "color_background",
      "id": "background",
      "label": "Background",
      "default": "linear-gradient(#ffffff, #000000)"
    }
  ],
  "presets": [
    {
      "name": "Header"
    }
  ]
}
{% endschema %}
