<section>
 {% paginate collection.products by 24 %}
  <div class="container">
    <h1>{{ collection.title | default: 'Collection' }}</h1>
    <p>⚑ products_count = {{ collection.products_count }}</p>

    <div class="grid grid--4">
      {% for product in collection.products %}
        <article style="border:1px solid #e6e6e6;padding:12px">
          <a href="{{ product.url }}">{{ product.title }}</a> — {{ product.price | money }}
          {% if product.available %}
            <form method="post" action="{{ routes.cart_add_url }}" style="margin-top:8px">
              <input type="hidden" name="id" value="{{ product.first_available_variant.id }}">
              <input name="quantity" value="1" size="2">
              <button type="submit">Add</button>
            </form>
          {% endif %}
        </article>
      {% else %}
        <p>No products found.</p>
      {% endfor %}
    </div>

    {% if paginate.pages > 1 %}
      <nav>
        {% if paginate.previous %}<a href="{{ paginate.previous.url }}">Prev</a>{% endif %}
        <span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
        {% if paginate.next %}<a href="{{ paginate.next.url }}">Next</a>{% endif %}
      </nav>
    {% endif %}
  </div>
{% endpaginate %}


</section>
